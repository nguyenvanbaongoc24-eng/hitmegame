<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This API hosts no static files.  Do not crawl nested test/tool outputs
         as Web SDK content; those folders can recursively contain server builds. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Assets\Scripts\Core\Phase1\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
    <!-- Web SDK otherwise treats nested test/tool build outputs as web content,
         which recursively copies bin folders through the project reference. -->
    <Content Remove="Tests\**\*;Tools\**\*;bin\**\*;obj\**\*" />
    <None Remove="Tests\**\*;Tools\**\*;bin\**\*;obj\**\*" />
  </ItemGroup>
</Project>
